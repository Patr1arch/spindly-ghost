<Window xmlns="https://github.com/avaloniaui"
        xmlns:controls="using:AnotherGraphEditor.Controls"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="AnotherGraphEditor.MainWindow"
        Title="AnotherGraphEditor"
        Width="600"
        Height="600"
        >
    <StackPanel>
        <Button Click="Button_OnClick">Создать прямоугольник</Button>
        <controls:DrawingSurface x:Name="DrawingSurfaceControl" Width="500" Height="500" />
    </StackPanel>
</Window>
